rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function requiredBaseMode() {
      return request.auth.token.email == "onesmemory@gmail.com"
        ? "legacy"
        : "empty";
    }

    // 각 사용자는 자신의 전국도감 문서만 읽고 수정할 수 있습니다.
    // 소유자 계정은 기존 도감을 유지하고, 다른 신규 계정은 미보유로 시작합니다.
    match /users/{userId}/collections/nationalDex {
      allow read: if ownsDocument(userId);

      allow create: if ownsDocument(userId)
        && request.resource.data.baseMode == requiredBaseMode();

      // 최초 생성된 시작 모드는 이후 변경할 수 없습니다.
      allow update: if ownsDocument(userId)
        && request.resource.data.baseMode == resource.data.baseMode;

      allow delete: if ownsDocument(userId);
    }

    // 그 외 모든 Firestore 경로는 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
